generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nombre       String
  email        String   @unique
  password     String
  rol          Rol
  puesto       String?
  departamento String?
  telefono     String?
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  proyectosGerente ProyectoGerente[]
  clavesCreadas    Clave[]
  planosSubidos    Plano[]
  autorizaciones   AutorizacionInterna[]
  auditoriaAdmin   AuditoriaAdmin[]
  permisos         PermisoUsuario[]

  @@index([rol])
  @@index([activo])
}

model Cliente {
  id           Int       @id @default(autoincrement())
  nombre       String
  nombreCorto  String
  descripcion  String?
  razonSocial  String?
  rfc          String?
  activo       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  proyectos    Proyecto[]

  @@index([activo])
}

model Modulo {
  id          Int       @id @default(autoincrement())
  nombre      String
  slug        String    @unique
  descripcion String?
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  permisos    PermisoUsuario[]
}

model PermisoUsuario {
  id        Int          @id @default(autoincrement())
  usuarioId Int
  moduloId  Int
  nivel     NivelPermiso @default(VER)

  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  modulo    Modulo  @relation(fields: [moduloId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, moduloId])
}

model Proyecto {
  id              Int             @id @default(autoincrement())
  nombre          String
  clienteId       Int?
  clienteContacto String?
  pinAcceso       String          @unique
  estatus         EstatusProyecto @default(ACTIVO)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  cliente  Cliente? @relation(fields: [clienteId], references: [id])
  gerentes ProyectoGerente[]
  claves   Clave[]
  ordenes  OrdenCambio[]

  @@index([estatus])
  @@index([clienteId])
}

model ProyectoGerente {
  id         Int      @id @default(autoincrement())
  proyectoId Int
  usuarioId  Int
  createdAt  DateTime @default(now())

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([proyectoId, usuarioId])
  @@index([proyectoId])
  @@index([usuarioId])
}

model Clave {
  id          Int          @id @default(autoincrement())
  proyectoId  Int
  codigo      String
  descripcion String
  estatus     EstatusClave @default(BORRADOR)
  creadoPorId Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  proyecto  Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  creadoPor Usuario  @relation(fields: [creadoPorId], references: [id])
  planos    Plano[]

  @@unique([proyectoId, codigo])
  @@index([estatus])
  @@index([proyectoId])
}

model Plano {
  id                Int      @id @default(autoincrement())
  claveId           Int
  urlPdf            String   @db.Text
  version           Int      @default(1)
  subidoPorId       Int
  comentariosCostos String?  @db.Text
  createdAt         DateTime @default(now())

  clave                  Clave                 @relation(fields: [claveId], references: [id], onDelete: Cascade)
  subidoPor              Usuario               @relation(fields: [subidoPorId], references: [id])
  autorizacionesInternas AutorizacionInterna[]
  autorizacionCliente    AutorizacionCliente?
  notificaciones         Notificacion[]

  @@unique([claveId, version])
  @@index([claveId])
}

model AutorizacionInterna {
  id          Int      @id @default(autoincrement())
  planoId     Int
  gerenteId   Int
  decision    Decision
  comentarios String?
  createdAt   DateTime @default(now())

  plano   Plano   @relation(fields: [planoId], references: [id], onDelete: Cascade)
  gerente Usuario @relation(fields: [gerenteId], references: [id])

  @@unique([planoId, gerenteId])
  @@index([planoId])
}

model AutorizacionCliente {
  id             Int      @id @default(autoincrement())
  planoId        Int      @unique
  decision       Decision
  comentarios    String?
  firmadoPor     String
  cargoFirmante  String?
  firmaBase64    String?  @db.Text
  urlPdfFirmado  String?  @db.Text
  ipCliente      String?
  createdAt      DateTime @default(now())

  plano Plano @relation(fields: [planoId], references: [id], onDelete: Cascade)
}

model Notificacion {
  id        Int      @id @default(autoincrement())
  planoId   Int
  tipo      String
  leida     Boolean  @default(false)
  createdAt DateTime @default(now())

  plano Plano @relation(fields: [planoId], references: [id], onDelete: Cascade)
}

model AuditoriaAdmin {
  id        Int      @id @default(autoincrement())
  usuarioId Int?
  actor     String?
  accion    String
  detalle   String?
  ip        String?
  createdAt DateTime @default(now())

  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([createdAt])
  @@index([accion])
}

model IntentoAccesoCliente {
  id        Int      @id @default(autoincrement())
  ip        String
  pin       String
  exitoso   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([createdAt])
}

model OrdenCambio {
  id                      String   @id @default(uuid())
  numOrden                String   @unique
  tipo                    TipoOrden
  proyectoId              Int
  proyectoNombre          String
  clienteNombre           String
  contacto                String?
  supervisorBaum          String
  ventasBaum              String
  generadaPor             String?
  fechaSolicitud          String
  solicitadaPor           String
  concepto                String   @db.Text
  total                   Float    @default(0)
  ivaPorcentaje           Float    @default(16)
  ivaImporte              Float    @default(0)
  neto                    Float    @default(0)
  afectacionDias          Int      @default(0)
  requiereFirmaAdicional  Boolean  @default(false)
  nombreFirmaAdicional    String?
  numeroContrato          String?
  pdfFilename             String?
  cancelada               Boolean  @default(false)
  creadoEn                DateTime @default(now())
  updatedAt               DateTime @updatedAt

  proyecto   Proyecto  @relation(fields: [proyectoId], references: [id])
  partidas   Partida[]
  firmas     Firma[]
  fotos      FotoOrden[]
  tokens     TokenFirma[]

  @@index([proyectoId])
  @@index([tipo])
  @@index([cancelada])
}

model Partida {
  id         Int         @id @default(autoincrement())
  ordenId    String
  codigo     String?
  concepto   String      @db.Text
  precio     Float
  cantidad   Float
  total      Float
  orden      OrdenCambio @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  @@index([ordenId])
}

model Firma {
  id        Int         @id @default(autoincrement())
  ordenId   String
  rol       RolFirma
  nombre    String?
  empresa   String?
  imagen    String?     @db.Text
  fecha     DateTime?
  orden     OrdenCambio @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  @@unique([ordenId, rol])
  @@index([ordenId])
}

model TokenFirma {
  id      Int         @id @default(autoincrement())
  ordenId String
  rol     RolFirma
  token   String      @unique @default(uuid())
  usado   Boolean     @default(false)
  orden   OrdenCambio @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  @@unique([ordenId, rol])
  @@index([token])
}

model FotoOrden {
  id      Int         @id @default(autoincrement())
  ordenId String
  dataUrl String      @db.Text
  nota    String?
  orden   OrdenCambio @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  @@index([ordenId])
}

enum Rol {
  DUENO
  SUPERADMIN
  GERENTE
  DISENADOR
  COSTOS
}

enum NivelPermiso {
  VER
  EDITAR
  ADMIN
}

enum EstatusProyecto {
  ACTIVO
  PAUSADO
  COMPLETADO
}

enum Decision {
  APROBADO
  RECHAZADO
}

enum EstatusClave {
  BORRADOR
  REVISION_INTERNA
  ENVIADO
  RECHAZADO
  AUTORIZADO
  LIBERADO
  EN_PRODUCCION
}

enum TipoOrden {
  cambio
  extraordinaria
  trabajo
}

enum RolFirma {
  cliente
  ventas
  supervisor
  adicional
}
