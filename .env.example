# ============================================
# BASE DE DATOS
# ============================================
# Desarrollo (Neon PostgreSQL):
DATABASE_URL="postgresql://usuario:password@ep-xxxx.us-east-2.aws.neon.tech/baum?sslmode=require"

# Producción (Hostinger MySQL) — cambiar provider en schema.prisma a "mysql":
# DATABASE_URL="mysql://usuario:password@servidor.hostinger.com:3306/baum_prod"

# ============================================
# NEXTAUTH
# ============================================
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="reemplazar-con-string-aleatorio-de-32-caracteres-minimo"
NEXTAUTH_URL="http://localhost:3000"
# En producción: NEXTAUTH_URL="https://baum.tudominio.com"

# ============================================
# GMAIL SMTP (Nodemailer)
# ============================================
# Crear App Password en: https://myaccount.google.com/apppasswords
GMAIL_USER="baum.webapp@gmail.com"
GMAIL_PASS="xxxx xxxx xxxx xxxx"

# Email remitente visible
EMAIL_FROM="BAUM Industria Carpintera <baum.webapp@gmail.com>"

# ============================================
# UPLOADTHING (almacenamiento de PDFs)
# ============================================
# Crear cuenta en https://uploadthing.com y obtener token
UPLOADTHING_TOKEN="eyJhcGlLZXkiOiJza19saXZlX..."
UPLOADTHING_SECRET="sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
UPLOADTHING_APP_ID="xxxxxxxxxx"

# ============================================
# URL PÚBLICA DEL SISTEMA
# ============================================
# Usada en links de emails enviados a clientes y equipo
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# En producción: NEXT_PUBLIC_APP_URL="https://baum.tudominio.com"

# ============================================
# AMBIENTE
# ============================================
NODE_ENV="development"
